---
import type { EvaluatedCoupon } from '../types/game.js';

interface Props {
  coupon: EvaluatedCoupon;
  isExpired?: boolean;
}

const { coupon, isExpired = false } = Astro.props;

const badgeClass =
  coupon.status === 'upcoming'
    ? 'badge-upcoming'
    : coupon.status === 'expiring_today'
    ? 'badge-warning'
    : coupon.status === 'expired'
    ? 'badge-expired'
    : coupon.status === 'undetermined'
    ? 'badge-neutral'
    : 'badge-active';
---

<div
  class={`coupon-card ${isExpired || coupon.status === 'expired' ? 'is-expired' : ''} ${coupon.status === 'upcoming' ? 'is-upcoming' : ''}`}
  data-coupon-card
  data-code={coupon.code}
  data-starts-at={coupon.startsAt || ''}
  data-expires-at={coupon.expiresAt || ''}
  data-status={coupon.status}
>
  <div class="coupon-header">
    <div class="coupon-code-wrap">
      <code class="coupon-code" data-code-text>{coupon.code}</code>
      <span class={`badge ${badgeClass}`} data-badge>{coupon.dDayLabel}</span>
    </div>
    <button
      type="button"
      class="btn-copy"
      data-copy-btn
      data-code={coupon.code}
      aria-label={`쿠폰 코드 ${coupon.code} 복사`}
    >
      <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="btn-text">복사</span>
    </button>
  </div>

  <div class="coupon-body">
    <p class="reward-row">
      <span class="label">보상</span>
      <strong class="reward-text">{coupon.reward}</strong>
    </p>

    <div class="coupon-footer-meta">
      {coupon.formattedStartsAt && (
        <span class="start-text" data-start-label>
          사용 시작: {coupon.formattedStartsAt}
        </span>
      )}
      <span class="expiry-text" data-expiry-label>
        만료: {coupon.formattedExpiresAt}
      </span>
      {coupon.sourceUrl && (
        <a
          href={coupon.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="source-link"
          aria-label={`공식 공지 확인 (${coupon.code})`}
        >
          공식 공지 ↗
        </a>
      )}
    </div>

    {coupon.notes && <p class="notes-text">{coupon.notes}</p>}
  </div>
</div>

<style>
  .coupon-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 16px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.15s ease;
  }

  .coupon-card:hover {
    border-color: #CBD5E1;
  }

  .coupon-card.is-upcoming {
    border-color: #DDD6FE;
    background-color: #FAF5FF;
  }

  .coupon-card.is-expired {
    background-color: #F8FAFC;
    opacity: 0.85;
  }

  .coupon-card.is-expired .coupon-code {
    color: var(--text-muted);
    background-color: #F1F5F9;
  }

  .coupon-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .coupon-code-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .coupon-code {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--primary);
    background-color: var(--primary-light);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
    user-select: all;
    border: 1px solid #BFDBFE;
  }

  .coupon-card.is-upcoming .coupon-code {
    color: #6D28D9;
    background-color: #EDE9FE;
    border-color: #DDD6FE;
  }

  .btn-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    background-color: var(--primary);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease, transform 0.05s ease;
    flex-shrink: 0;
  }

  .btn-copy:hover {
    background-color: var(--primary-hover);
  }

  .btn-copy:active {
    transform: scale(0.98);
  }

  .btn-copy.copied {
    background-color: #059669 !important;
    color: #FFFFFF !important;
  }

  .coupon-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 1px solid #F1F5F9;
    padding-top: 10px;
  }

  .reward-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 0.9375rem;
    color: var(--text-primary);
  }

  .reward-row .label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--bg-subtle);
    padding: 1px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .reward-text {
    font-weight: 600;
    color: var(--text-primary);
  }

  .coupon-footer-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--text-muted);
    flex-wrap: wrap;
  }

  .start-text {
    color: #7C3AED;
    font-weight: 600;
  }

  .source-link {
    color: var(--primary);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .source-link:hover {
    color: var(--primary-hover);
  }

  .notes-text {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  @media (max-width: 480px) {
    .coupon-header {
      flex-direction: column;
      align-items: stretch;
    }

    .coupon-code-wrap {
      justify-content: space-between;
    }

    .btn-copy {
      width: 100%;
    }
  }
</style>
