    background-color: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 12px 16px;
  }

  .disclaimer-text {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .footer-meta {
    text-align: center;
  }

  .copyright {
    font-size: 0.75rem;
